<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 深色系统启动窗（values-night-v31）。
  同样需完整重复深色基础主题的 item，再追加 splash 属性；
  splash 背景取 DarkSurface (#1A181C)，避免深色模式下闪白。
-->
<resources>
    <style name="Theme.RoundTrace" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowSplashScreenBackground">#1A181C</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_transparent</item>
    </style>
</resources>
