<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 云备份与设备迁移规则：只备份数据库与 SharedPreferences。
     cache 目录本来就不参与备份/迁移，无需 exclude。 -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
